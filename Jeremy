-- 87. Consultar los 5 clientes con mayores compras.
SELECT TOP 5 C.cNombre, SUM(V.nMonto) AS TotalComprado 
FROM TCliente C INNER JOIN TVenta V ON C.nClienteID = V.nClienteID 
GROUP BY C.cNombre ORDER BY TotalComprado DESC;

-- 88. Consultar ventas por mes.
SELECT MONTH(dFechaVenta) AS Mes, YEAR(dFechaVenta) AS Anio, SUM(nMonto) AS TotalVendido 
FROM TVenta GROUP BY YEAR(dFechaVenta), MONTH(dFechaVenta) ORDER BY Anio, Mes;

-- 89. Consultar promedio de ventas por cliente.
SELECT C.cNombre, AVG(V.nMonto) AS PromedioCompra 
FROM TCliente C INNER JOIN TVenta V ON C.nClienteID = V.nClienteID 
GROUP BY C.cNombre;

-- 90. Generar un reporte consolidado utilizando JOIN entre tres tablas (Cliente, Venta, Empleado).
SELECT V.nVentaID, C.cNombre AS Cliente, E.cNombre AS EmpleadoAtendio, V.nMonto, V.dFechaVenta
FROM TVenta V
INNER JOIN TCliente C ON V.nClienteID = C.nClienteID
INNER JOIN TEmpleado E ON V.nEmpleadoID = E.nEmpleadoID;
