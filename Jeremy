-- 81. Crear una tabla TCliente con al menos 8 campos y restricciones.
CREATE TABLE TCliente (
    nClienteID INT IDENTITY(1,1) PRIMARY KEY,
    cCodigo VARCHAR(10) UNIQUE NOT NULL,
    cNombre NVARCHAR(100) NOT NULL,
    cCorreo NVARCHAR(100) UNIQUE,
    cTelefono VARCHAR(20),
    dFechaRegistro DATETIME DEFAULT GETDATE(),
    bEsFrecuente BIT DEFAULT 0,
    nLimiteCredito DECIMAL(10,2) CHECK (nLimiteCredito >= 0)
);

-- 82. Crear una tabla TVenta relacionada con TCliente (y TEmpleado para el JOIN de 3 tablas).
CREATE TABLE TVenta (
    nVentaID INT IDENTITY(1,1) PRIMARY KEY,
    nClienteID INT NOT NULL,
    nEmpleadoID INT NOT NULL,
    dFechaVenta DATETIME DEFAULT GETDATE(),
    nMonto DECIMAL(10,2) CHECK (nMonto > 0),
    CONSTRAINT Fk_Venta_Cliente FOREIGN KEY (nClienteID) REFERENCES TCliente(nClienteID),
    CONSTRAINT Fk_Venta_Empleado FOREIGN KEY (nEmpleadoID) REFERENCES TEmpleado(nEmpleadoID)
);

