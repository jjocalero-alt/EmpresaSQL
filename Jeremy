-- 84. Registrar 50 ventas (Insertando de forma resumida para no hacer el script eterno).
DECLARE @i INT = 1;
WHILE @i <= 50
BEGIN
    INSERT INTO TVenta (nClienteID, nEmpleadoID, nMonto, dFechaVenta)
    VALUES (
        (ABS(CHECKSUM(NEWID())) % 20) + 1, -- Cliente Aleatorio entre 1 y 20
        (SELECT TOP 1 nEmpleadoID FROM TEmpleado ORDER BY NEWID()), -- Empleado Aleatorio
        (ABS(CHECKSUM(NEWID())) % 500) + 50, -- Monto Aleatorio
        DATEADD(DAY, -(ABS(CHECKSUM(NEWID())) % 180), GETDATE()) -- Fecha en los últimos 6 meses
    );
    SET @i = @i + 1;
END;

